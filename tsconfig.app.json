{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ES2020",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src"]
}
